# Hosted profile (the $0 public demo). Copy the names into the Vercel project's environment
# variables; never commit real values. Details: DEPLOY.md, "Public demo at $0".
AGROTECA_PROFILE=hosted
AGROTECA_DB_URL=
AGROTECA_DB_POOL_MIN=1
AGROTECA_JINA_API_KEY=
AGROTECA_GEN_API_KEY=
AGROTECA_OPENAI_MODEL=openai/gpt-oss-120b
AGROTECA_OPENAI_REASONING_EFFORT=low
AGROTECA_GEN_TIMEOUT=60
AGROTECA_TRANSLATE_TIMEOUT=15
AGROTECA_ONNX_MODEL_FILE=onnx/model.onnx
AGROTECA_ONNX_MODEL_REVISION=main
AGROTECA_DAILY_REQUEST_CAP=20
AGROTECA_PER_IP_HOURLY_CAP=5
AGROTECA_IP_HASH_SALT=
